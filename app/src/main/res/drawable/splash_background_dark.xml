<?xml version="1.0" encoding="utf-8"?>
<!-- Dark splash: medium logo (half of previous max size) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1020" />
        </shape>
    </item>
    <item
        android:left="72dp"
        android:top="72dp"
        android:right="72dp"
        android:bottom="72dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/kgta_logo" />
    </item>
</layer-list>
