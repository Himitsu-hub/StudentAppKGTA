<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App brand blue -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A336C" />
        </shape>
    </item>
    <!--
      Logo with large insets so nothing is clipped on any screen.
      bitmap + gravity=center scales to fit inside the padded area.
    -->
    <item
        android:left="72dp"
        android:top="72dp"
        android:right="72dp"
        android:bottom="72dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_app_splash" />
    </item>
</layer-list>
