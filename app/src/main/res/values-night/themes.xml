<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StudentApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A1020</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.StudentApp.Dark</item>
        <item name="android:windowBackground">@drawable/splash_background_dark</item>
        <item name="android:statusBarColor">#0A1020</item>
        <item name="android:navigationBarColor">#0A1020</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.StudentApp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#0A1020</item>
        <item name="android:navigationBarColor">#0A1020</item>
        <item name="android:windowBackground">#0A1020</item>
    </style>
</resources>
